# Copie para .env e ajuste. NUNCA versione o .env.
DJANGO_SECRET_KEY=gere-com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=geop.shoppingcarpina.com.br
CSRF_TRUSTED_ORIGINS=https://geop.shoppingcarpina.com.br
DATABASE_URL=postgres://geop:senha@localhost:5432/geop
# DB_SSL_REQUIRE=true
MEDIA_ROOT=/data/media
# REDIS_URL=redis://localhost:6379/0   # recomendado com mais de um processo (bloqueio de login compartilhado)
SESSION_IDLE_MINUTES=60

# Fotos: maior lado (px), qualidade (1-95), formato (WEBP ou JPEG), limite do upload (MB)
GEOP_IMAGEM_LADO_MAX=1600
GEOP_IMAGEM_QUALIDADE=75
GEOP_IMAGEM_FORMATO=WEBP
GEOP_UPLOAD_MAX_MB=15
GEOP_NOME_UNIDADE=Shopping Carpina

# Mesmo valor de APP_PUBLIC_SHARE_SECRET do PHP => links públicos de OS já enviados continuam válidos.
# GEOP_PUBLIC_SHARE_SECRET=

# Com nginx servindo a mídia privada (X-Accel-Redirect). Ver README.
# GEOP_X_ACCEL_REDIRECT_PREFIX=/protected-media/

# Importação do PHP (somente leitura)
# LEGACY_DATABASE_URL=mysql://usuario:senha@host:3306/shoppingcarpinac_geopsc

# Banco externo de patrimônio (somente leitura)
# PATRIMONIO_DATABASE_URL=mysql://usuario:senha@host:3306/shoppingcarpinac_tickets
# PATRIMONIO_TABELA=assets
