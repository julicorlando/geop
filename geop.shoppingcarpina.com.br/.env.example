APP_ENV=production
APP_DEBUG=false
APP_URL=https://geop.example.com
APP_TIMEZONE=America/Recife
APP_KEY=change-to-a-long-random-secret
PRIVATE_PATH=/home/account/geop-private
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=geop
DB_USER=geop
DB_PASS=change-me
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_FROM=no-reply@example.com
CRON_SECRET=change-to-a-long-random-secret

# GEOP IA V8.1
OPENAI_API_KEY=
GEOP_AI_MODEL=gpt-5.6
OPENAI_API_BASE=https://api.openai.com/v1

# GEOP IA V8.1.1 - Ollama local
GEOP_AI_PROVIDER=OLLAMA
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_NUM_CTX=8192

# Opcional: quando Ollama estiver atrás do Cloudflare Access
OLLAMA_CF_ACCESS_CLIENT_ID=
OLLAMA_CF_ACCESS_CLIENT_SECRET=

# Opcional: se houver proxy reverso com Bearer Token
OLLAMA_BEARER_TOKEN=

# OpenAI fica disponível como alternativa
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_API_BASE=https://api.openai.com/v1

# GEOP IA V8.1.2 - Groq Cloud
GEOP_AI_PROVIDER=GROQ
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
